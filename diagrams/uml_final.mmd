classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
    }

    class Task {
        +str description
        +int duration_minutes
        +str frequency
        +bool is_completed
        +str priority
        +str time
        +date due_date
        +mark_complete() None
    }

    class Scheduler {
        +filter_tasks(owner: Owner, pet_name: str, is_completed: bool) list
        +sort_by_time(schedule: list) list
        +get_schedule(owner: Owner, sort_by: str, pet_name: str, is_completed: bool, on_date: date) list
        +mark_task_complete(pet: Pet, task: Task, completed_on: date) Task
        +detect_conflicts(schedule: list) list
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : tracks
    Scheduler ..> Owner : reads
    Scheduler ..> Pet : schedules for
    Scheduler ..> Task : sorts, filters, and completes
