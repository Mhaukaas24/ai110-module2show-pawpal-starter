classDiagram
    class Owner {
        +str name
        +int available_minutes_per_day
        +list preferences
        +list pets
        +add_pet(pet) None
        +update_preferences(preferences) None
    }

    class Pet {
        +str name
        +str species
        +list care_tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class CareTask {
        +str title
        +int duration_minutes
        +str priority
        +str category
    }

    class DailyPlan {
        +date plan_date
        +Pet pet
        +list scheduled_tasks
        +dict explanations
        +total_duration() int
        +explain() str
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" CareTask : needs care
    DailyPlan "1" --> "1" Pet : plans for
    DailyPlan "1" --> "0..*" CareTask : schedules
